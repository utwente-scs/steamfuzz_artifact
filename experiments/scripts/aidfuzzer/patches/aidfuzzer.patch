diff --git a/framework/src/fuzzer/iofuzzer.cpp b/framework/src/fuzzer/iofuzzer.cpp
index ff02529d1..3be89c0de 100644
--- a/framework/src/fuzzer/iofuzzer.cpp
+++ b/framework/src/fuzzer/iofuzzer.cpp
@@ -716,6 +716,10 @@ void fuzz_runonce(FuzzState *state)
     {
       printf("pc %x queue %x not found stream %x\n",exit_info.exit_pc,q->cksum,exit_info.stream_info.exit_stream_id);
     }
+    printf("  BBs executed: %lu  IRQs injected: %lu  MMIO reads: %lu\n",
+           (unsigned long)exit_info.executed_bbls,
+           (unsigned long)exit_info.injected_irqs,
+           (unsigned long)exit_info.mmio_reads);
     update_exit_info(state,&exit_info);
     if(f)
       fprintf(f,"%lu %d\n",q->create_time,state->total_unique_bbls);
@@ -723,6 +727,50 @@ void fuzz_runonce(FuzzState *state)
     if(terminate_next)
       fuzzer_terminate(state);
   }
+
+  // Also run crashing inputs from the corpus.
+  // Each crash entry has its own pool sidecar (pool_<cksum>.bin) that must be
+  // loaded before running the entry, because the stream pool at crash time may
+  // differ from the shared queue pool.
+  {
+    DIR* crash_dir_handle;
+    struct dirent* crash_dir_entry;
+    char crash_filename[PATH_MAX];
+    char crash_pool_filename[PATH_MAX];
+    u32 crash_cksum;
+
+    crash_dir_handle = opendir(state->dir_info.crash_queue_dir.c_str());
+    if (crash_dir_handle != NULL) {
+      while ((crash_dir_entry = readdir(crash_dir_handle)) != NULL) {
+        if (crash_dir_entry->d_type == DT_REG && strstr(crash_dir_entry->d_name, "queue_")) {
+          sscanf(crash_dir_entry->d_name, "queue_%x", &crash_cksum);
+          sprintf(crash_pool_filename, "%s/pool_%x.bin",
+                  state->dir_info.crash_queue_dir.c_str(), crash_cksum);
+          load_crash_pool(state, crash_pool_filename);
+          sprintf(crash_filename, "%s/%s",
+                  state->dir_info.crash_queue_dir.c_str(), crash_dir_entry->d_name);
+          queue_entry *q = load_queue(state, crash_filename);
+          EXIT_INFO exit_info = run_input(state, q, &simulator);
+          if (exit_info.exit_code == EXIT_DBG_STREAM_NOTFOUND) {
+            printf("pc %x queue %x not found stream %x\n",
+                   exit_info.exit_pc, q->cksum, exit_info.stream_info.exit_stream_id);
+          }
+          printf("  [crash] BBs executed: %lu  IRQs injected: %lu  MMIO reads: %lu\n",
+                 (unsigned long)exit_info.executed_bbls,
+                 (unsigned long)exit_info.injected_irqs,
+                 (unsigned long)exit_info.mmio_reads);
+          update_exit_info(state, &exit_info);
+          if (f)
+            fprintf(f, "%lu %d\n", q->create_time, state->total_unique_bbls);
+          show_stat(state);
+          if (terminate_next)
+            fuzzer_terminate(state);
+        }
+      }
+      closedir(crash_dir_handle);
+    }
+  }
+
   if(f)
     fclose(f);
 }
